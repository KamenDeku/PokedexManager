generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum CollectionStatus {
  CAUGHT
  NOT_CAUGHT
  RELEASED
}

enum TrainerStatus {
  PROFESSOR
  TRAINER
}

enum ChatRole {
  USER
  ASSISTANT
}

enum MemoryCategory {
  PREFERENCE
  FACT
}

// ==========================================
// USER
// ==========================================

model User {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  password  String
  role      TrainerStatus @default(TRAINER)
  createdAt DateTime      @default(now())

  collection Collection[]
  chatMessages ChatMessage[]
  memories     UserMemory[]
}

// ==========================================
// POKEMON
// ==========================================

model Pokemon {
  id        Int      @id @default(autoincrement())
  pokeApiId Int      @unique
  name      String
  createdAt DateTime @default(now())

  collection Collection[]
}

// ==========================================
// COLLECTION
// ==========================================

model Collection {
  id        Int              @id @default(autoincrement())
  userId    Int
  pokemonId Int
  status    CollectionStatus @default(CAUGHT)
  createdAt DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pokemon Pokemon @relation(fields: [pokemonId], references: [id])

  @@unique([userId, pokemonId])
}

// ==========================================
// BOT
// ==========================================

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
}

model UserMemory {
  id        Int            @id @default(autoincrement())
  userId    Int
  category  MemoryCategory @default(FACT)
  content   String         @db.VarChar(300)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
